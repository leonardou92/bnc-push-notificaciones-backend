    "migrate:rename-logs": "node scripts/rename_log_table.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "@prisma/client": "^5.10.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "prisma": "^5.10.0"
  }

}
